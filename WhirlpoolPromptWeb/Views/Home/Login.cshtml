@{
    Layout = null;
    ViewData["Title"] = "Login";
}



<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="container-fluid p-0">
    <div class="row m-0 min-vh-100">

        <!-- Lado Izquierdo: Formulario -->
        <div class="col-6 d-flex align-items-center justify-content-center bg-light">
            <div class="w-75">
                <h2 class="mb-4 text-center">Inicio de </h2>
                <form>
                    <div class="mb-3">
                        <label for="exampleInputEmail1" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
                        <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
                    </div>
                    <div class="mb-3">
                        <label for="exampleInputPassword1" class="form-label">Password</label>
                        <input type="password" class="form-control" id="exampleInputPassword1">
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="exampleCheck1">
                        <label class="form-check-label" for="exampleCheck1">Check me out</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Submit</button>
                </form>
            </div>
        </div>

        <!-- Lado Derecho: Imagen Completa -->
        <div class="col-6 p-0 bg-image-column">
        </div>

    </div>
</div>